APP_PORT=8080
APP_NAME="BMC SmartFind"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_WITH_32_BYTE_LARAVEL_KEY
APP_URL=http://IP_SERVER_PORTAINER:8080
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
BCRYPT_ROUNDS=12

MYSQL_HOST=192.168.10.51
MYSQL_PORT=3306
MYSQL_DATABASE=pw2
MYSQL_USER=root
MYSQL_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

# Host path on the Portainer/Docker server, not a path on this PC.
DOCUMENTS_PATH=/opt/qualityhub/data/SmartFindDocuments
BMC_STORAGE_PATH=/mnt/documents

SESSION_DRIVER=database
SESSION_LIFETIME=180
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SESSION_PARTITIONED_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

SMARTFIND_SAME_ORIGIN_ENABLED=false
SMARTFIND_CSP_ENABLED=true
SMARTFIND_HSTS_ENABLED=false
SMARTFIND_REMEMBER_LOGIN_ENABLED=false
SMARTFIND_LOGIN_MAX_ATTEMPTS=5
SMARTFIND_LOGIN_DECAY_SECONDS=300
SMARTFIND_LOGIN_IP_MAX_ATTEMPTS=20
SMARTFIND_LOGIN_IP_DECAY_SECONDS=300
SMARTFIND_PASSWORD_MIN_LENGTH=12
SMARTFIND_PASSWORD_MAX_LENGTH=128
SMARTFIND_IDLE_TIMEOUT_MINUTES=60
SMARTFIND_ABSOLUTE_SESSION_TIMEOUT_MINUTES=720
SMARTFIND_MAX_CONCURRENT_SESSIONS=3
SMARTFIND_SESSION_PASSWORD_FINGERPRINT=true

SMARTFIND_CORS_PATHS=api/*,sanctum/csrf-cookie,login,logout
SMARTFIND_CORS_ALLOWED_ORIGINS=http://IP_SERVER_PORTAINER:8080

AI_SMART_SEARCH_ENABLED=false
AI_SMART_SEARCH_URL=http://127.0.0.1:8765
AI_SMART_SEARCH_CONNECT_TIMEOUT=1
AI_SMART_SEARCH_TIMEOUT=5
AI_SMART_SEARCH_TOP_K=20
AI_SMART_SEARCH_CANDIDATE_LIMIT=250

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="BMC SmartFind"
